<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="horizontal">

    <!-- Step 1: Concept -->
    <LinearLayout
        android:id="@+id/stepIdeation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivStep1"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_step_inactive"
            android:padding="8dp"
            android:src="@drawable/ic_add"
            app:tint="@color/text_hint" />

        <TextView
            android:id="@+id/tvStep1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="CONCEPT"
            android:textColor="@color/text_hint"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/line1"
        android:layout_width="20dp"
        android:layout_height="2dp"
        android:layout_marginBottom="12dp"
        android:background="#E5E7EB" />

    <!-- Step 2: Research -->
    <LinearLayout
        android:id="@+id/stepResearch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivStep2"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_step_inactive"
            android:padding="8dp"
            android:src="@drawable/ic_ideas"
            app:tint="@color/text_hint" />

        <TextView
            android:id="@+id/tvStep2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="RESEARCH"
            android:textColor="@color/text_hint"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/line2"
        android:layout_width="20dp"
        android:layout_height="2dp"
        android:layout_marginBottom="12dp"
        android:background="#E5E7EB" />

    <!-- Step 3: Planning -->
    <LinearLayout
        android:id="@+id/stepPrototype"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivStep3"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_step_inactive"
            android:padding="8dp"
            android:src="@drawable/ic_dashboard"
            app:tint="@color/text_hint" />

        <TextView
            android:id="@+id/tvStep3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="PLANNING"
            android:textColor="@color/text_hint"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/line3"
        android:layout_width="20dp"
        android:layout_height="2dp"
        android:layout_marginBottom="12dp"
        android:background="#E5E7EB" />

    <!-- Step 4: Execution -->
    <LinearLayout
        android:id="@+id/stepLaunch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivStep4"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_step_inactive"
            android:padding="8dp"
            android:src="@drawable/ic_flow"
            app:tint="@color/text_hint" />

        <TextView
            android:id="@+id/tvStep4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="EXECUTION"
            android:textColor="@color/text_hint"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>